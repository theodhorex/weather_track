# --- Next.js dashboard env (read at runtime by /app/api/* routes) ---
# Copy this file to .env.local and fill in real values.

# Full URL to InfluxDB v2 instance (include scheme, no trailing slash).
INFLUX_URL=https://influxdb.asoytabang.online

# InfluxDB API token (read+write scope for the bucket below is enough).
INFLUX_TOKEN=your_influxdb_token_here

# Organization ID or name as configured in InfluxDB.
INFLUX_ORG=your_org_here

# Bucket name where the Python collector writes data (default: "weather").
INFLUX_BUCKET=weather
